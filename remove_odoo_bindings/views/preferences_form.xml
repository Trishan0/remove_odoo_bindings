<?xml version="1.0"?>
<odoo>
    <data>
        <!-- Hide Notification from user preference form !-->
        <record id="view_users_form_simple_modif_mail_custom" model="ir.ui.view">
            <field name="name">res.users.preferences.form.mail.custom</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="mail.view_users_form_simple_modif_mail"/>
            <field name="arch" type="xml">
                <field name="notification_type" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
            </field>
        </record>

        <record id="view_users_form_mail_custom" model="ir.ui.view">
            <field name="name">res.users.form.mail.custom</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="mail.view_users_form_mail"/>
            <field name="arch" type="xml">
                <field name="notification_type" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
            </field>
        </record>


