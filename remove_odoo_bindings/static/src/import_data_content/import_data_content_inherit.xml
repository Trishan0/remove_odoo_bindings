<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="ImportDataContent" t-inherit-mode="extension">
        <xpath expr="//th[normalize-space()='Odoo Field']" position="replace">
            <th scope="col" style="width: 20%;">Field</th>
        </xpath>
        <xpath expr="//p[hasclass('alert-info')]" position="replace">
            <p class="alert alert-info mb-0">
                If the file contains column names, the application can try to
                detect the matching field automatically. This simplifies files
                with many columns.
            </p>
        </xpath>
    </t>
</templates>
