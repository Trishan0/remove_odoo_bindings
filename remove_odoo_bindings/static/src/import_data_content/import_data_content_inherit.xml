<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="ImportDataContent" t-inherit-mode="extension">
        <xpath expr="//th[normalize-space()='Odoo Field']" position="replace">
            <th scope="col">Field</th>
        </xpath>

        <xpath expr="//p[contains(@class, 'alert-info')]" position="replace">
            <p class="alert alert-info mb-0">
                If the file contains column names, the system can try to auto-detect
                the field corresponding to each column. This makes files with many
                columns easier to import.
            </p>
        </xpath>
    </t>
</templates>
